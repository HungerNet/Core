{
  "name": "hungernet-platform",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "corepack enable && pnpm install && cp .env.example .env && cd backend && uv sync",
    "dev": "turbo run dev --parallel",
    "dev:frontend": "turbo run dev --parallel",
    "dev:backend": "cd backend && . .venv/bin/activate && uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:all": "pnpm dev:backend & pnpm dev:frontend",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "backend:test": "cd backend && . .venv/bin/activate && pytest -q",
    "docker:up": "docker compose -f infra/docker-compose.yml up --build",
    "docker:down": "docker compose -f infra/docker-compose.yml down -v",
    "check": "pnpm backend:test && pnpm lint && pnpm typecheck && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript-eslint": "^8.26.0",
    "typescript": "^5.8.2"
  }
}
