{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ifamished",
  "main": "./worker.ts",
  "compatibility_date": "2026-06-20",
  "observability": {
    "enabled": true
  },
    "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/v1", "/api/v1/*"],
    "not_found_handling": "single-page-application"
    },
  "vars": {
    "HUNGERNET_API_ORIGIN": "https://api.hacklets.dev"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
